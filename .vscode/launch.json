{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Depurar proceso principal de Electron",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}/packages/desktop",
			"runtimeExecutable": "${workspaceFolder}/node_modules/.bin/vite",
			"windows": {
				"runtimeExecutable": "${workspaceFolder}/node_modules/.bin/vite.cmd"
			},
			"env": {
				"WEBSITE_URL": "http://localhost:4400"
			},
			"console": "integratedTerminal",
			"outputCapture": "std"
		},
		{
			"name": "Depurar web (Chrome, puerto 4400)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:4400",
			"webRoot": "${workspaceFolder}/packages/web/src/web",
			"sourceMapPathOverrides": {
				"/@fs/*": "${workspaceFolder}/*"
			}
		}
	]
}
